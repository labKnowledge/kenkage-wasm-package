# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Zig toolchain (large, machine-fetched — see tools/zig symlink)
/tools/zig-*/

# Local dev database
/db/*.db

# Scratch/agent tool output, not part of the project
/tool-results/

# Build artifacts (regenerated by lightpanda-wasm build scripts)
core.wasm
test_zig.wasm

# Intermediate copy the Zig build scripts write to before build.mjs copies
# into lightpanda-wasm/dist/ (the one actually published/imported) — pure
# build output, not a source of truth.
/lightpanda-wasm/src/dist/

# Zig build cache/output (regenerated by `zig build`)
.zig-cache/
zig-out/